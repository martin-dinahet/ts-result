{
  "name": "@punpun-dev/ts-option",
  "version": "0.1.0",
  "description": "A tiny TypeScript Option type for explicit nullable and optional values",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "types",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "option",
    "maybe",
    "nullable",
    "typescript",
    "rust-style",
    "algebraic-data-types"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/martin-dinahet/ts-option"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm build"
  }
}
