{
  "name": "ts-result-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm build && pnpm -r typecheck",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "publish:option": "pnpm --filter @punpun-dev/ts-option publish --access public --no-git-checks",
    "publish:result": "pnpm --filter @punpun-dev/ts-result publish --access public --no-git-checks",
    "publish:packages": "pnpm publish:option && pnpm publish:result"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.13",
    "@types/node": "^25.6.0",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md}": "pnpm exec biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
  }
}
